{
  "index_patterns": ["ml-*"],
  "template": {
    "settings": { "number_of_replicas": 0 },
    "mappings": {
      "dynamic_templates": [
        { "strings_as_keyword": { "match_mapping_type": "string", "mapping": { "type": "keyword" } } },
        { "numbers_as_float": { "match_mapping_type": "long", "mapping": { "type": "float" } } }
      ],
      "properties": {
        "@timestamp": { "type": "date" },
        "prediction": { "type": "float" },
        "latency_ms": { "type": "float" },
        "max_psi": { "type": "float" },
        "prediction_psi": { "type": "float" },
        "n": { "type": "integer" },
        "alert": { "type": "boolean" }
      }
    }
  }
}
